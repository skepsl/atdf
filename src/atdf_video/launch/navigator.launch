

<launch>
  <arg name="map_file" default="21202A.yaml"/>
  <param name="/use_sim_time" value="true"/>

  <!-- Load the map -->
  <node pkg="map_server" type="map_server" name="map_server" args="$(find atdf_video)/maps/$(arg map_file)">
      <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_velodyne"
      args="0 0 0 0 0 0 base_link base_laser_link" >
      <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_imu"
      args="0 0 0.05 0 0 0 base_link imu_link">
      <param name="use_sim_time" value="true"/>
  </node>

  <!-- ODOM -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization" clear_params="true">
    <param name="use_sim_time" value="true"/>
    <param name="sensor_timeout" value="5"/>
    <param name="frequency" value="50"/>
    <param name="two_d_mode" value="true"/>
    <param name="map_frame" value="map"/>
    <param name="odom_frame" value="odom"/>
    <param name="base_link_frame" value="base_link"/>
    <param name="world_frame" value="odom"/>
    <param name="transform_time_offset" value="0.0"/>
    <rosparam command="load" file="$(find atdf_video)/config/ekf_odom.yaml"/>
    <param name="transform_tolerance" value="0.2"/>
  </node>

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="laser_model_type" value="likelihood_field"/>
    <param name="transform_tolerance" value="0.3"/>
    <param name="global_frame_id" value="map"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="scan_topic" value="scan"/>
    <param name="laser_frame_id" value="base_laser_link"/>
    <param name="tf_broadcast" value="true"/>
    <param name="use_map_topic" value="true"/>
    <param name="initial_pose_x" value="0.0"/>
    <param name="initial_pose_y" value="0.0"/>
    <param name="initial_pose_a" value="0.0"/>
    <param name="initial_cov_xx" value="0.05"/>
    <param name="initial_cov_yy" value="0.05"/>
    <param name="initial_cov_aa" value="0.02"/>
    <param name="update_min_d" value="0.1"/>
    <param name="update_min_a" value="0.03"/>
    <param name="min_particles" value="800"/>
    <param name="max_particles" value="5000"/>
    <param name="odom_alpha1" value="0.2"/>
    <param name="odom_alpha2" value="0.2"/>
    <param name="odom_alpha3" value="0.2"/>
    <param name="odom_alpha4" value="0.2"/>
    <param name="laser_z_hit" value="0.9"/>
    <param name="laser_sigma_hit" value="0.2"/>
    <param name="laser_z_rand" value="0.1"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>
    <param name="resample_interval" value="1"/>
    <param name="do_beamskip" value="true"/>
    <param name="beam_skip_distance" value="0.5"/>
    <param name="beam_skip_threshold" value="0.3"/>
    <param name="beam_skip_error_threshold" value="0.9"/>
    <param name="kld_err" value="0.02"/>
    <param name="kld_z" value="0.99"/>
    <param name="laser_max_range" value="8.0"/>
    <param name="laser_min_range" value="0.1"/>

    </node>

  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="transform_tolerance" value="0.2"/>
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>

    <rosparam file="$(find atdf_video)/config/global_planner_globalplanner.yaml" command="load"/>
    <rosparam file="$(find atdf_video)/config/local_planner_teb.yaml" command="load"/>
    <rosparam file="$(find atdf_video)/config/move_base_params.yaml" command="load" />


    <rosparam file="$(find atdf_video)/config/costmap_local.yaml" command="load"/>
    <rosparam file="$(find atdf_video)/config/costmap_global.yaml" command="load"/>
  </node>

  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find atdf_video)/rviz/rviz_display.rviz">
      <param name="use_sim_time" value="true"/>
  </node>

</launch>



